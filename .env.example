# Ambiente alvo: demo | dev | qa | hml | prod
TEST_ENV=demo

# URL do ambiente "demo" (padrão: https://www.saucedemo.com)
BASE_URL=https://www.saucedemo.com

# URLs dos demais ambientes (obrigatórias apenas quando TEST_ENV os selecionar)
BASE_URL_DEV=
BASE_URL_QA=
BASE_URL_HML=
BASE_URL_PROD=

# Credenciais de teste. No Sauce Demo, os usuários e a senha pública de
# demonstração aparecem na própria tela de login do site.
TEST_USERNAME=
TEST_PASSWORD=
TEST_LOCKED_USERNAME=

# Navegador: chromium | firefox | webkit
BROWSER=chromium

# true executa sem abrir janela; false mostra o navegador
HEADLESS=true

# Tempo máximo de espera da Browser Library (ex.: 10s, 30s)
TIMEOUT=10s
